# Backend-only environment. Copy to backend/.env and fill in real values.
# See the repository root .env.example for the full documented reference.
NODE_ENV=development
PORT=3001
API_PREFIX=api/v1
CORS_ORIGINS=http://localhost:3000
DEFAULT_TIMEZONE=Africa/Dar_es_Salaam
LOG_LEVEL=debug

# PostgreSQL connection used by Prisma. The backend is the ONLY consumer.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/shoprex?schema=public

# --- Authentication (Phase 1) ---
# Any random string of at least 16 characters. Change it per environment.
JWT_SECRET=shoprex_local_dev_secret_change_me
JWT_EXPIRES_IN=8h

# --- Development sign-in convenience ---
# When true (and NODE_ENV is not production), GET /auth/dev-credentials returns
# the seeded accounts and the web login form prefills itself. Always false in
# any deployed environment.
DEV_LOGIN_AUTOFILL=true
DEV_ADMIN_EMAIL=admin@shoprex.co.tz
DEV_OWNER_EMAIL=owner@shoprex.co.tz
DEV_SEED_PASSWORD=shoprex12345

# --- Rate limiting (requests per window, per client address) ---
RATE_LIMIT_DEFAULT=120
RATE_LIMIT_AUTH=10
RATE_LIMIT_TTL_MS=60000

# --- Device enrollment ---
# How long a one-time device enrollment code stays valid, in minutes. Short on
# purpose: the code is a secret handed to a worker on paper, and an unused one
# should stop working the same day it was written down. 5–1440.
DEVICE_ENROLLMENT_TTL_MINUTES=60
