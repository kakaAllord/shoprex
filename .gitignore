# --- Environment ---
.env
.env.*
!.env.example

# --- Untracked ----
untracked/

# --- Node / TypeScript ---
node_modules/
dist/
build/
coverage/
*.tsbuildinfo
npm-debug.log*
yarn-error.log*
pnpm-debug.log*

# --- Next.js ---
web/.next/
web/out/
web/next-env.d.ts

# --- Prisma ---
backend/prisma/*.db
backend/generated/

# --- React Native / Expo ---
mobile/.expo/
mobile/dist/
mobile/web-build/
# Native projects are generated by `expo prebuild`; keep them out of git.
mobile/android/
mobile/ios/
*.jks
*.keystore
*.p8
*.p12
*.mobileprovision

# --- Database backups (Phase 8) ---
# `node backend/scripts/backup.js` writes here. A dump is a complete copy of a
# shop's trading — every price, every debtor's name, every staff password hash
# — so it is the single worst file in this repository to commit by accident.
backend/backups/
*.dump

# --- Editors / OS ---
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db

