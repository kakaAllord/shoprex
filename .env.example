# =============================================================================
# Shoprex V1 — environment variable reference
# =============================================================================
# This file documents variable NAMES only. Never commit real secrets.
#
# Copy the sections you need:
#   backend/.env   <- everything under [BACKEND] and [DATABASE]
#   web/.env.local <- everything under [WEB]
#   mobile/.env    <- everything under [MOBILE]
#
# Shoprex V1 is online-only. There are no offline/sync related variables.
# =============================================================================

# -----------------------------------------------------------------------------
# [DATABASE] PostgreSQL — used by backend/ ONLY.
# The web app and the mobile app must NEVER receive these values.
# -----------------------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=shoprex
POSTGRES_PORT=5432

# Full connection string consumed by Prisma (backend/.env).
# Matches the docker-compose.yml service when left at the local defaults.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/shoprex?schema=public

# -----------------------------------------------------------------------------
# [BACKEND] NestJS API — the single authoritative service.
# -----------------------------------------------------------------------------
NODE_ENV=development
PORT=3001
API_PREFIX=api/v1

# Comma-separated list of browser origins allowed to call the API.
# The Flutter app is not a browser client and is not affected by CORS.
CORS_ORIGINS=http://localhost:3000

# Default business timezone used for local-day report boundaries (Phase 7).
DEFAULT_TIMEZONE=Africa/Dar_es_Salaam

# Log verbosity: error | warn | log | debug | verbose
LOG_LEVEL=debug

# How long a one-time device enrollment code stays valid, in minutes. Short on
# purpose: the code is a secret handed to a worker on paper, and an unused one
# should stop working the same day it was written down. 5-1440.
DEVICE_ENROLLMENT_TTL_MINUTES=60

# --- Not yet used in the foundation phase; reserved for Phase 1/2 ---
# JWT_SECRET=
# JWT_ACCESS_TOKEN_TTL=15m
# JWT_REFRESH_TOKEN_TTL=30d

# -----------------------------------------------------------------------------
# [WEB] Next.js owner / platform-admin app.
# NEXT_PUBLIC_* values are exposed to the browser. Put no secrets here.
# -----------------------------------------------------------------------------
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001/api/v1

# Server-side base URL used by React Server Components. Inside Docker this is
# the service hostname; on a plain local machine it equals the public URL.
API_BASE_URL=http://localhost:3001/api/v1

# -----------------------------------------------------------------------------
# [MOBILE] React Native (Expo) Android app -> copy to mobile/.env
#
# EXPO_PUBLIC_* values are embedded in the app bundle at build time, so restart
# Metro and rebuild the development client after changing them. Never put a
# secret here. The app has no fallback address: a missing value fails loudly.
#
# Emulator:       http://10.0.2.2:3001/api/v1   (10.0.2.2 = the host machine)
# Physical phone: http://<your-LAN-IP>:3001/api/v1
# -----------------------------------------------------------------------------
EXPO_PUBLIC_SHOPREX_API_BASE_URL=http://10.0.2.2:3001/api/v1
