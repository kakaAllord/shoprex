# Mobile app environment. Copy to mobile/.env
# See the repository root .env.example for the full documented reference.
#
# EXPO_PUBLIC_* variables are embedded in the app bundle at build time.
# Never put a secret here — the mobile app holds no database credentials and
# no service keys; it talks to the Shoprex backend only.

# 10.0.2.2 is the Android emulator's route to the host machine.
# On a physical phone use the development machine's LAN IP, e.g.
# http://192.168.1.20:3001/api/v1
EXPO_PUBLIC_SHOPREX_API_BASE_URL=http://10.0.2.2:3001/api/v1
