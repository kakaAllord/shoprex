# Web app environment. Copy to web/.env.local.
# See the repository root .env.example for the full documented reference.
#
# The web app must NEVER hold PostgreSQL credentials. It reads and writes
# through the Shoprex backend API only.

# Used by browser (client component) requests.
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001/api/v1

# Used by server components / route handlers running inside Next.js.
API_BASE_URL=http://localhost:3001/api/v1

# Development sign-in convenience. The login form prefills itself from the
# backend seeded accounts when the backend has DEV_LOGIN_AUTOFILL=true and is
# not running in production. Nothing to configure here.
